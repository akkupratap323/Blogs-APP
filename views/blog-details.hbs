<div class="container my-5">
  {{#if blog}}
    <div class="card shadow-lg" style="border: none; border-radius: 12px; overflow: hidden;">
      {{#if blog.image}}
        <img src="{{blog.image}}" class="card-img-top" alt="{{blog.title}}" 
             style="max-height: 400px; width: 100%; object-fit: cover;">
      {{/if}}
      
      <div class="card-body">
        <h1 class="card-title" style="font-weight: 600; color: #343a40;">{{blog.title}}</h1>
        <div class="card-text" style="color: #6c757d; font-size: 1.1rem; line-height: 1.6;">
          {{{blog.body}}}  {{!-- Triple braces to render HTML if stored as HTML --}}
        </div>
        <p class="text-muted mt-3" style="font-size: 0.9rem;">
          Posted by: {{blog.author.username}}
          {{#if blog.createdAt}} 
            on {{formatDate blog.createdAt}}
          {{/if}}
        </p>
      </div>
      
      <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
        <a href="/" class="btn btn-primary" 
           style="border-radius: 8px; font-weight: 500; background-color: #007bff; border: none;">
          Back to Home
        </a>
        
        {{#if user}}
          {{#if (eq user._id.toString blog.author._id.toString)}}
            <form action="/blog/{{blog._id}}/delete" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="{{csrfToken}}"> {{!-- CSRF protection --}}
              <button type="submit" class="btn btn-danger" 
                onclick="return confirm('Are you sure you want to delete this blog?')"
                style="border-radius: 8px; font-weight: 500; border: none;">
                Delete Blog
              </button>
            </form>
          {{/if}}
        {{/if}}
      </div>
    </div>
  {{else}}
    <div class="alert alert-danger">
      Blog not found or has been deleted
      <a href="/" class="alert-link">Return to homepage</a>
    </div>
  {{/if}}
</div>